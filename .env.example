# From @BotFather
BOT_TOKEN=123456:ABC-DEF-your-token

# dev = skip initData check (browser testing with a fake user id=1)
APP_ENV=dev

# Public https origin serving the Mini App frontend (a tunnel URL in dev)
WEBAPP_URL=

DB_PATH=./data/diary.db
MEDIA_DIR=./data/media
INITDATA_TTL=86400

# Meal photos are shrunk to JPEG on upload
PHOTO_MAX_SIDE=1280
PHOTO_QUALITY=80

# polling (default, outbound only) or webhook
BOT_MODE=polling

# Telegram user ids for the admin commands (/users /userreport /userdiary).
# Comma or space separated. Overrides the built-in default when set.
ADMIN_IDS=
