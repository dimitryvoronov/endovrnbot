# MAX bot access_token from https://max.ru/MasterBot
BOT_TOKEN=

# dev = skip initData check (browser testing with a fake user id=1)
APP_ENV=dev

# Public https origin serving the Mini App frontend (a tunnel URL in dev)
WEBAPP_URL=

# MAX Bot API base.
MAX_API_BASE=https://botapi.max.ru
# Name of a registered Mini App **Direct Link** (dev.max.ru), NOT the bot username.
# If unset (or not a real link) the /menu "Открыть дневник" open_app button is skipped.
MAX_WEBAPP_NAME=

DB_PATH=./data/diary.db
MEDIA_DIR=./data/media
INITDATA_TTL=86400

# Meal photos are shrunk to JPEG on upload
PHOTO_MAX_SIDE=1280
PHOTO_QUALITY=80

# polling (default, outbound only) or webhook
BOT_MODE=polling

# MAX user ids for the admin commands (/users /userreport /userdiary).
# Comma or space separated.
ADMIN_IDS=

# Webhook secret (X-Max-Bot-Api-Secret). Derived from the token if unset.
MAX_WEBHOOK_SECRET=
